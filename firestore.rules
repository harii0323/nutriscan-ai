rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public product/food cache – read by anyone, write only by functions
    match /artifacts/{appId}/public/data/{collection}/{docId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }

    // User data – only accessible by the owning user
    match /artifacts/{appId}/users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Saved products sub-collection
      match /savedProducts/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Scan history sub-collection
      match /scans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
