rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Authentication & Ownership Helpers ─────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Prevent client escalation of privileges or tampering with system fields
    function notModifyingProtectedFields() {
      return !('isAdmin' in request.resource.data) &&
             !('role' in request.resource.data) &&
             !('permissions' in request.resource.data);
    }

    // ─── Public Product Cache (Read-only for clients, writes by backend only) ──
    match /artifacts/{appId}/public/data/{type}/{docId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions / Admin SDK can write
    }

    // ─── User Profile and Private Data (Strict Least Privilege) ────────────────
    match /artifacts/{appId}/users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && notModifyingProtectedFields();
      allow delete: if isOwner(uid);

      // Saved products sub-collection
      match /savedProducts/{productId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && notModifyingProtectedFields();
        allow delete: if isOwner(uid);
      }

      // Scan history sub-collection
      match /scans/{scanId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && notModifyingProtectedFields();
        allow delete: if isOwner(uid);
      }

      // User-scoped subcollections (e.g. exports, private preferences)
      match /{userSubcollections=**} {
        allow read, write: if isOwner(uid) && notModifyingProtectedFields();
      }
    }

    // ─── Deny All Other Access By Default ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
