{
  "name": "nutriscan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src scripts",
    "test": "vitest run",
    "test:fast": "vitest run src/__tests__/unit.test.js src/__tests__/integration.test.js src/__tests__/functional.test.jsx src/__tests__/security-build.test.js src/__tests__/backend-security-auth.test.js src/__tests__/firestore-rules.test.js",
    "test:security": "vitest run src/__tests__/security-build.test.js src/__tests__/backend-security-auth.test.js src/__tests__/firestore-rules.test.js",
    "test:e2e": "vitest run src/__tests__/e2e-api.test.js",
    "test:perf": "node scripts/performance-test.mjs",
    "test:watch": "vitest",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "validate:config": "node scripts/validate-business-config.mjs",
    "validate:config:strict": "node scripts/validate-business-config.mjs --strict",
    "build:functions": "npm --prefix functions run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "firebase": "^12.19.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
