# NutriScan AI – Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.

# ── Firebase ──────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Backend Service URL (Cloud Function / Express Proxy) ───────────────────
# All Gemini AI inference and protected database operations are routed
# through this backend. GEMINI_API_KEY is stored securely on the server
# (e.g. Firebase Secret Manager / Google Secret Manager) and NEVER on the client.
# Example: https://us-central1-your-project.cloudfunctions.net/api
VITE_BACKEND_URL=https://nutriscan-ai-xm4u.onrender.com/api

# ── App ID (used for Firestore paths) ─────────────────────────────────────────
VITE_APP_ID=nutriscan-ai
