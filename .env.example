# NutriScan AI – Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.

# ── Firebase ──────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Gemini (DEV ONLY – use backend Cloud Function in production) ──────────────
# WARNING: This exposes your Gemini key in the browser bundle.
# For production, leave this blank and use VITE_BACKEND_URL instead.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Backend URL (Cloud Function proxy) ───────────────────────────────────────
# Set this to your deployed Firebase Function URL in production.
# Example: https://us-central1-your-project.cloudfunctions.net
VITE_BACKEND_URL=

# ── App ID (used for Firestore paths) ─────────────────────────────────────────
VITE_APP_ID=nutriscan-ai
