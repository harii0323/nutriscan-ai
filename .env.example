# NutriScan AI - Environment Variables Template
# Copy this file to .env.local and populate with deployment credentials.
# NEVER commit .env.local or production secrets to version control.

# --- Firebase Client SDK (Public Client Identifiers) ------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Backend Service Gateway URL --------------------------------------------
# All AI calls, distributed rate limiting, and account erasure routes proxy through this URL.
# Client NEVER connects directly to Google Generative Language endpoints.
# Example: https://us-central1-your-project.cloudfunctions.net/api or Render/Cloud Run URL
VITE_BACKEND_URL=https://nutriscan-ai-xm4u.onrender.com/api

# --- App Artifact ID (Used for Firestore partition paths) -------------------
VITE_APP_ID=nutriscan-ai

# --- Verified Production Business & Operator Configuration ------------------
# Required for strict production release gates (India DPDP Act 2023 & statutory compliance)
VITE_BUSINESS_LEGAL_NAME=
VITE_SUPPORT_EMAIL=
VITE_GRIEVANCE_OFFICER_NAME=
VITE_GRIEVANCE_EMAIL=
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_JURISDICTION=New Delhi / Bengaluru, India

# --- Backend Cloud Functions Server Environment (NOT for frontend bundle) ----
# Configure in Google Cloud Secret Manager / Firebase Functions Environment:
# GEMINI_API_KEY=your_google_ai_studio_api_key
# ADDITIONAL_ALLOWED_ORIGINS=https://custom-domain.com
# NODE_ENV=production
